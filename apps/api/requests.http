### 1. Sign up (creates a fresh account after your DB reset)
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "12345678"
}

### 2. Log in (use this anytime you need a fresh token — tokens last 7 days)
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "somepassword123"
}

### ============================================
### Paste your token below and reuse it in every
### request that needs "Authorization: Bearer ..."
### ============================================

### 3. Create a business (grab the "slug" and "id" from the response)
POST http://localhost:3000/businesses
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

{
    "name": "Test Business",
    "location": "Sto. Tomas, Batangas"
}

### 4. List your businesses (if you forget the slug/id later)
GET http://localhost:3000/businesses
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

### 5. Create a service (paste businessId from step 3)
POST http://localhost:3000/services
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

{
    "businessId": "cmtxdsc1600024q8nnov0t5up",
    "name": "Test Service",
    "durationMin": 30,
    "price": 300
}

### 6. Create a staff member (paste businessId from step 3)
POST http://localhost:3000/staff
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

{
    "businessId": "cmtxdsc1600024q8nnov0t5up",
    "name": "Test Staff"
}

### 7. List services (grab serviceId if needed)
GET http://localhost:3000/services?businessId=cmtxdsc1600024q8nnov0t5up
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

### 8. List staff (grab staffId if needed)
GET http://localhost:3000/staff?businessId=cmtxdsc1600024q8nnov0t5up
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

### 9. Check availability for Dec 3, 2026 (paste serviceId + staffId)
GET http://localhost:3000/public/availability?serviceId=cmtxdtoo600044q8n43enyckg&staffId=cmtxdu3tn00064q8n6tenefyt&date=2026-12-03

### 10. Create a booking for Dec 3, 2026 directly via API
### (or just use the actual public booking page at
### http://localhost:3001/book/YOUR_SLUG instead of this)
POST http://localhost:3000/public/bookings
Content-Type: application/json

{
    "businessId": "cmtxdsc1600024q8nnov0t5up",
    "serviceId": "cmtxdtoo600044q8n43enyckg",
    "staffId": "cmtxdu3tn00064q8n6tenefyt",
    "startsAt": "2026-12-03T14:00:00",
    "customerName": "Dec Test Customer",
    "customerPhone": "09171234567"
}

### 11. List today's bookings for this business
### (should NOT include the Dec 3 booking — only today's date)
GET http://localhost:3000/bookings?businessId=cmtxdsc1600024q8nnov0t5up
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

### 12. Check a specific booking's status directly
### (paste the booking id from step 10's response)
PATCH http://localhost:3000/bookings/cmtxe154a000g4q8n34ykakcc/status
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXR4ZHJteWUwMDAwNHE4bjZyajBydWtwIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwiaWF0IjoxNzg5MTU2ODA2LCJleHAiOjE3ODk3NjE2MDZ9.Jbs70Nh9N7MoEulq2i-m6wADYR4CpAUdE-f1tsQwl8g

{ "status": "COMPLETED" }

